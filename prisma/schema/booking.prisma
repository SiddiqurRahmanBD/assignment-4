model Booking{
    id String @id @default(uuid())
    renterId String
    renter User @relation(fields: [renterId], references: [id])

    startDate DateTime
    endDate DateTime 
    totalPrice Float

    bookingStatus BookingStatus @default(PENDING)
    createdAt DateTime @default(now())

    //payment

    payments Payment[]
}

enum BookingStatus {
    PENDING
    CONFIRMED
    CANCELLED
}