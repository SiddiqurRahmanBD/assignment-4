model Payment {
    id String @id @default (uuid())
    bookingId String
    booking Booking @relation(fields: [bookingId], references: [id])
    transactionId String @unique
    amount Float
    status PaymentStatus @default(PENDING)
    paidat DateTime @default(now())
   
}

enum PaymentStatus {
    PENDING
    COMPLETED
    FAILED
}